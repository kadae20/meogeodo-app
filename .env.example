# Supabase — 프로젝트 설정 > API에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 구 anon key를 쓰는 경우 (둘 중 하나만 있으면 됨)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude API (선택 — 없으면 fallback parser로 동작)
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-5

# 공공데이터포털 가공식품 영양성분 (선택)
# DATA_GO_KR_SERVICE_KEY=

# 앱 공개 URL (OAuth/매직링크 콜백). 배포 도메인을 넣는다.
NEXT_PUBLIC_SITE_URL=https://meogeodo-app.vercel.app

# Google 간편 로그인 (동의 화면이 앱 도메인으로 뜨도록 서버에서 코드 교환)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
